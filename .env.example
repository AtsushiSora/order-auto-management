# Supabaseを未設定のまま起動すると、従来どおり架空データのデモモードになります。
# 本番値は .env.local にだけ保存し、Gitへコミットしないでください。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# ローカル開発では未設定でも表示されます。公開テスト環境で必要な場合だけtrueにします。
VITE_ENABLE_TEST_LOGIN=true
# Google Driveへ直接保存する場合に、Google Cloudのウェブ用OAuthクライアントIDを設定します。
VITE_GOOGLE_CLIENT_ID=
